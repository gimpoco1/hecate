VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MAPKIT_TOKEN=
# Optional alternative to a build-time token. Required for native builds if
# the token endpoint isn't hosted at https://hecate-eta.vercel.app.
VITE_MAPKIT_TOKEN_ENDPOINT=
# Keep the whole PEM in one quoted value; use literal "\\n" between lines.
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# Comma-separated browser/native origins permitted to obtain a token.
APPLE_MAPS_ALLOWED_ORIGINS=https://hecate-eta.vercel.app,capacitor://localhost,http://localhost:5173
# Optional fallback for non-browser token requests. Browser tokens use their exact origin.
APPLE_MAPS_ORIGIN=https://hecate-eta.vercel.app
