VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Valhalla-compatible walking router; use an appropriate hosted endpoint for production.
VITE_WALKING_ROUTER_URL=https://valhalla1.openstreetmap.de/route

# 0 disables dev tools; 1 enables them, including in production builds.
VITE_ENABLE_DEV_TOOLS=0
# Photon-compatible destination search endpoint.
VITE_DESTINATION_SEARCH_URL=https://photon.komoot.io/api/

# Photon-compatible reverse geocoding endpoint for map-picked destinations.
VITE_DESTINATION_REVERSE_URL=https://photon.komoot.io/reverse

# Server-only Apple Maps signing credentials. Never prefix these with VITE_.
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY=
APPLE_MAPS_ORIGIN=https://hecate-explore.vercel.app
APPLE_MAPS_ALLOWED_ORIGINS=https://hecate-explore.vercel.app,capacitor://localhost,https://localhost,http://127.0.0.1:5173,http://localhost:5173
# Native bundles require an HTTPS token API hosted outside the WebView.
VITE_MAPKIT_TOKEN_ENDPOINT=https://hecate-explore.vercel.app/api/mapkit-token
