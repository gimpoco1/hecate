{
  "name": "hecate-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:achievement-ids": "node scripts/check-achievement-id-parity.mjs",
    "prebuild": "npm run check:achievement-ids",
    "build": "tsc -b && vite build",
    "pretest": "npm run check:achievement-ids",
    "test": "vitest run",
    "test:ios-motion": "node scripts/test-ios-reminder-motion.mjs",
    "test:ios-google-callback": "node scripts/test-ios-google-callback.mjs",
    "postinstall": "node scripts/patch-background-geolocation.mjs",
    "preview": "vite preview",
    "ios:add": "npm run build && npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "ios:run:xcode": "zsh scripts/run-ios-in-xcode.sh",
    "ios:version": "node scripts/bump-ios-version.mjs",
    "android:add": "npm run build && npx cap add android",
    "android:release": "node scripts/build-signed-android-release.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "check:functions": "deno check --config supabase/functions/publish-leaderboard/deno.json supabase/functions/publish-leaderboard/index.ts && deno check --config supabase/functions/notify-feedback/deno.json supabase/functions/notify-feedback/index.ts && deno test supabase/functions/_shared/http_test.ts"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/action-sheet": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@mdi/js": "^7.4.47",
    "@supabase/supabase-js": "^2.57.4",
    "maplibre-gl": "^6.9.0",
    "motion": "^12.43.0",
    "ogl": "^1.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "deno": "^2.9.6",
    "typescript": "~5.9.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@capacitor/cli": {
      "xcode": "^4.0.0"
    }
  }
}
