{
  "name": "hecate-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:achievement-ids": "node scripts/check-achievement-id-parity.mjs",
    "prebuild": "npm run check:achievement-ids && npm run check:translations && node scripts/sync-native-translations.mjs",
    "build": "tsc -b && vite build",
    "pretest": "npm run check:achievement-ids && npm run check:translations",
    "test": "vitest run",
    "test:ios-motion": "node scripts/test-ios-reminder-motion.mjs",
    "test:ios-google-callback": "node scripts/test-ios-google-callback.mjs",
    "postinstall": "node scripts/patch-background-geolocation.mjs",
    "preview": "vite preview",
    "ios:add": "npm run build && npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "ios:run:xcode": "zsh scripts/run-ios-in-xcode.sh",
    "ios:version": "node scripts/bump-ios-version.mjs",
    "android:add": "npm run build && npx cap add android",
    "android:release": "node scripts/build-signed-android-release.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "check:functions": "deno check --config supabase/functions/publish-leaderboard/deno.json supabase/functions/publish-leaderboard/index.ts && deno check --config supabase/functions/notify-feedback/deno.json supabase/functions/notify-feedback/index.ts && deno test supabase/functions/_shared/http_test.ts",
    "check:translations": "node scripts/check-translations.mjs",
    "lint": "eslint . --fix",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/action-sheet": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@mapbox/vector-tile": "^3.0.0",
    "@mdi/js": "^7.4.47",
    "@supabase/supabase-js": "^2.57.4",
    "clipper2-ts": "^2.0.1",
    "earcut": "^3.2.4",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "maplibre-gl": "^6.9.0",
    "motion": "^12.43.0",
    "ogl": "^1.0.11",
    "pbf": "^5.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.1.9",
    "stackblur-canvas": "^3.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "deno": "^2.9.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@capacitor/cli": {
      "xcode": "^4.0.0"
    }
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": "eslint --fix --no-warn-ignored"
  }
}
